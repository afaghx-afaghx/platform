# Copy to .env locally. Never commit a filled .env file.
# A real CrewAI execution calls the configured OpenAI API and may incur cost.
OPENAI_API_KEY=
# Source writes remain disabled until you explicitly set this to 1 for a task branch.
AFAGHX_WRITE_ENABLED=0
# Optional absolute path to the AFAGHX git checkout; auto-detected by default.
AFAGHX_REPO_ROOT=
