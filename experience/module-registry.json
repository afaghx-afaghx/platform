{
  "spec": "AFX-EXPERIENCE-MODULE-REGISTRY-001",
  "version": "1.0",
  "status": "canonical-proposed-pending-PR-approval",
  "layer": "AFX-EXPERIENCE",
  "repository": "afaghx-afaghx/platform",
  "purpose": "Canonical registry for the 17 AFAGHX public/role-specific experience entrypoints: one main ecosystem site plus 16 controlled module entrypoints.",
  "count": 17,
  "main_site_id": "AFX-00",
  "api_boundary": "https://api.afaghx.com",
  "rules": [
    "These entries are Experience entrypoints, not independent authentication authorities.",
    "All business truth remains in approved PLATFORM/DOMAIN services; Experience never connects directly to databases.",
    "AFX-CORE remains the authority for identity, authentication, authorization, tenant context, membership, policy, audit, consent and trust primitives.",
    "Each entrypoint must use versioned API/event contracts and the canonical security flow.",
    "Subdomains are presentation/application boundaries; they do not imply separate databases or independent security domains.",
    "No registry entry may be treated as a DOMAIN bounded context without an explicit architecture decision."
  ],
  "runtime_baseline": {
    "web_runtime": "Node.js >=20",
    "package_root": "experience/web",
    "test_command": "cd experience/web && npm test"
  },
