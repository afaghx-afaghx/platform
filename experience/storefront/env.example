# AFAGHX storefront environment — copy to .env.local and fill in.
# PLATFORM search binding (scripts/meilisearch/provision.ts writes these
# automatically after provisioning the engine).
MEILISEARCH_URL=http://127.0.0.1:7700
# search-only key (actions: ["search"], indexes: ["afaghx"]) — NOT the master key
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=afaghx

# Prisma (existing)
DATABASE_URL=file:../db/custom.db
