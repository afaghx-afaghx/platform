{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/afaghx-qwen3:14b-32k",
  "default_agent": "afaghx-engineer",
  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": 1200000
      },
      "models": {
        "afaghx-qwen3:14b-32k": {
          "name": "AFAGHX Qwen3 14B — tool calling, 32K context",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse *",
