{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5-coder:14b",
  "default_agent": "afaghx-engineer",
  "provider": {
    "ollama": {
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B"
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa": "deny"
    },
    "edit": {
      "*": "deny",
      ".ai/runtime/local-provider.contract.test.mjs": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "external_directory": {
      "*": "deny"
    },
    "task": "deny",
    "skill": "deny",
    "todowrite": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "deny",
      "pwd": "allow",
      "git rev-parse *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "node --test .ai/runtime/local-provider.contract.test.mjs": "allow",
      "node --test .ai/runtime/golden-execution.contract.test.mjs": "allow",
      "node --test platform/Gateway/runtime.integration.test.mjs": "allow",
      "npm --prefix core/AFX-CORE run test:security": "allow",
      "npm --prefix core/AFX-CORE run test:persistence": "allow"
    }
  }
}
