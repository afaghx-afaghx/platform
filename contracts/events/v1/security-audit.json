$schema: https://json-schema.org/draft/2020-12/schema
$id: https://contracts.afaghx.local/events/v1/security-audit.json
title: AFX Security Audit Event
version: 1
oneOf: []
type: object
additionalProperties: false
required: [id, occurredAt, actor, action, outcome]
properties:
  id: { type: string, format: uuid }
  occurredAt: { type: string, format: date-time }
  tenantId: { type: string, format: uuid }
  action: { type: string, minLength: 1 }
  outcome: { enum: [success, denied, failure] }
  actor:
    type: object
    additionalProperties: false
    required: [subject]
    properties:
      subject: { type: string }
      sessionId: { type: string, format: uuid }
  resource:
    type: object
    additionalProperties: false
    properties:
      type: { type: string }
      id: { type: string }
  metadata:
    type: object
