{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.afaghx.com/contracts/schemas/common/v1/common.schema.json",
  "title": "AFAGHX Common Primitives v1",
  "type": "object",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "tenantContext": {
      "type": "object",
      "required": ["organization_id", "tenant_id", "correlation_id"],
      "properties": {
        "organization_id": { "$ref": "#/$defs/uuid" },
        "tenant_id": { "$ref": "#/$defs/uuid" },
        "membership_id": { "$ref": "#/$defs/uuid" },
        "correlation_id": { "$ref": "#/$defs/uuid" },
        "causation_id": { "$ref": "#/$defs/uuid" }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["limit"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "cursor": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object", "additionalProperties": true },
        "correlation_id": { "$ref": "#/$defs/uuid" }
      },
      "additionalProperties": false
    }
  }
}
